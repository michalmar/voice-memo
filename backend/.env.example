VOICEPROMPT_ENVIRONMENT=development
VOICEPROMPT_ALLOW_DEVELOPMENT_AUTH=true
VOICEPROMPT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VOICEPROMPT_ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
VOICEPROMPT_ENTRA_REQUIRED_SCOPE=VoicePrompt.Access
VOICEPROMPT_ALLOWED_ENTRA_OBJECT_IDS=00000000-0000-0000-0000-000000000000
VOICEPROMPT_STORAGE_ACCOUNT_NAME=replace-with-storage-account
VOICEPROMPT_FOUNDRY_ENDPOINT=https://replace-with-foundry-endpoint
VOICEPROMPT_SPEECH_ENDPOINT=https://replace-with-existing-foundry-resource.cognitiveservices.azure.com
VOICEPROMPT_SPEECH_MODEL=MAI-Transcribe-2
VOICEPROMPT_SPEECH_API_VERSION=2025-10-15
VOICEPROMPT_CLEANUP_DEPLOYMENT=gpt-5.6-luna
# Leave unset for reasoning models; only set for models supporting this override.
# VOICEPROMPT_CLEANUP_TEMPERATURE=0
VOICEPROMPT_WEB_PUBSUB_ENDPOINT=https://replace-with-webpubsub.webpubsub.azure.com
